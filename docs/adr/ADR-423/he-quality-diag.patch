+        if (!info->rx_ctrl.rx_channel_estimate_info_vld) h_inv[bb]++;
+        /* Content quality by (format, vld): class 0 = HE256 vld=0, 1 = HE256 vld=1,
+         * 2 = HT64 vld=1. Change is measured only against the previous frame of the
