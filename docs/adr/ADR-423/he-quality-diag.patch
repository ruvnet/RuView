     s_cb_count++;
 
+    /* SCRATCH DIAG (not for commit): per-frame len x bb_format histogram. */
+    {
+        static uint32_t h_len[8][4]; /* bb_format 0..7 x {<=128,<=256,<=384,>384} */
+        static uint16_t h_max[8], h_min[8] = {0xffff,0xffff,0xffff,0xffff,0xffff,0xffff,0xffff,0xffff};
+        static uint32_t h_inv[8];
