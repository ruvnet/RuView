+         * per-frame gain normalisation (shape_change_pm: L1 of normalised
+         * distributions, 0..2000 permille). */
+        static uint32_t q_n[3], q_zero[3], q_shape[3], q_dn[3];
+        static float q_prev[3][256]; static float q_prevsum[3]; static uint8_t q_pmac[3][6]; static bool q_have[3];
+        int qc = -1; unsigned nb = 0;
+        bool vld = info->rx_ctrl.rx_channel_estimate_info_vld;
+        if (bb == 4 && info->len == 512) { qc = vld ? 1 : 0; nb = 256; }
+        else if (bb == 2 && info->len == 128 && vld) { qc = 2; nb = 64; }
+        if (qc >= 0 && info->buf) {
+            static float cur[256]; float sum = 0; uint32_t zero = 0;
+            for (unsigned k = 0; k < nb; k++) {
+                float i_ = info->buf[2 * k], q_ = info->buf[2 * k + 1];
+                cur[k] = sqrtf(i_ * i_ + q_ * q_);
+                if (cur[k] == 0.0f) zero++;
+                sum += cur[k];
+            }
+            if (q_have[qc] && sum > 0 && q_prevsum[qc] > 0 && memcmp(q_pmac[qc], info->mac, 6) == 0) {
+                float shp = 0;
+                for (unsigned k = 0; k < nb; k++) shp += fabsf(cur[k] / sum - q_prev[qc][k] / q_prevsum[qc]);
+                q_shape[qc] += (uint32_t)(shp * 1000.0f);
+                q_dn[qc]++;
+            }
+            memcpy(q_prev[qc], cur, nb * sizeof(float)); q_prevsum[qc] = sum;
+            memcpy(q_pmac[qc], info->mac, 6); q_have[qc] = true;
+            q_n[qc]++; q_zero[qc] += zero;
+        }
+        if ((s_cb_count % 500) == 0) {
+            static const char *qn[3] = {"HE256_vld0", "HE256_vld1", "HT64_vld1"};
+            for (unsigned c = 0; c < 3; c++) {
